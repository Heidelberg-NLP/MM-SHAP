/.vscode
/__pycache__
*.pyc

# uv / virtual environment
.venv/

# micromamba (local conda distribution + envs) for the legacy "before" stack
/.micromamba/
/bin/micromamba

# Model weights (fetched via scripts / HuggingFace, not tracked).
# The ALBEF *code* (models/, configs/) is now vendored; only the large
# checkpoints are fetched at setup time.
/ALBEF/checkpoints/*.pth

# Datasets and sample images (fetched via scripts/prepare_foil_sample.py)
/data/

# Pre-downloaded model snapshots (fetched via scripts/fetch_local_models.py)
/models_local/

# Local HuggingFace cache
/.hf_cache/

# Results written by the mm-shap_* scripts
/result_jsons/
/results_txts/

# Before/after regression harness outputs
/regression_results/
