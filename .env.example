# Copy to `.env` (gitignored) and fill in.
# HuggingFace Hub token: only needed for gated/private models.
# Get one at https://huggingface.co/settings/tokens
HF_TOKEN=hf_...

# Where to cache downloaded model weights (sets HF_HOME) so they don't fill $HOME.
HF_CACHE=/path/with/space/for/model/weights
